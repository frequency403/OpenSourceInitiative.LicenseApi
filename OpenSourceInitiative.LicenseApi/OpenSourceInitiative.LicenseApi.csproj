<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Title>OSI License API client for .NET</Title>
    <Description>Community-maintained .NET client for the Open Source Initiative (OSI) License API, the canonical catalog of OSI Approved Licenses. List, search and filter licenses by SPDX ID (with wildcards), name, keyword or steward, and retrieve the human-readable license text. Async, dependency-injection friendly (IHttpClientFactory), multi-targets net10.0 and netstandard2.0. Not affiliated with or endorsed by the Open Source Initiative.</Description>
    <PackageTags>osi;opensource;open-source;open-source-initiative;osi-approved;license;licenses;licensing;license-api;license-text;spdx;compliance;api-client;rest-client;dotnet;netstandard</PackageTags>
    <PackageReleaseNotes>https://github.com/frequency403/OpenSourceInitiative.LicenseApi/releases</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json"/>
  </ItemGroup>
</Project>